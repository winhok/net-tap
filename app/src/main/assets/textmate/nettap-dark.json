{
  "name": "nettap-dark",
  "type": "dark",
  "colors": {
    "editor.background": "#0D1117",
    "editor.foreground": "#E6EDF3",
    "editorLineNumber.foreground": "#7D8590",
    "editorCursor.foreground": "#56D364",
    "editor.selectionBackground": "#264F78"
  },
  "tokenColors": [
    {
      "scope": "string.quoted.double.json",
